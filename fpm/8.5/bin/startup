#!/bin/sh
set -e

# Normally already applied by the entrypoint; repeated here (it is idempotent)
# so startup still honours PHP_OPCACHE_JIT if the entrypoint is bypassed.
php-jit-flag

php-fpm -D

# apache2-foreground ships only with php:*-apache; on an FPM base Apache comes
# from Debian, so drive it with apache2ctl and source envvars for APACHE_RUN_*.
. /etc/apache2/envvars
exec apache2ctl -D FOREGROUND
