FROM php:8.3-cli

ENV DEBIAN_FRONTEND=noninteractive

# Setup Debian packages
RUN apt-get -y update && apt-get -y upgrade && ACCEPT_EULA=Y && apt-get install -y \
    procps \
    cron \
    unzip \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libzip-dev \
    libxml2-dev \
    libxslt-dev \
    libssl-dev \
    zlib1g-dev \
    libpng-dev \
    libwebp-dev \
    libjpeg-dev \
    libonig-dev \
    libicu-dev \
    apt-file \
    wget \
    gnupg \
    gnupg2 \
    zip \
    git \
    curl \
    gcc \
    g++ \
    autoconf \
    libc-dev \
    pkg-config \
    iputils-ping \
    netcat-openbsd \
    default-mysql-client \
    util-linux \
    gosu \
    jq \
    redis-tools \
    vim \
    python3 \
    liblz4-dev \
    libzstd-dev \
    libpq-dev \
    libmagickwand-dev \
    imagemagick \
    ghostscript \
    libavif-dev \
    libmaxminddb0 \
    libmaxminddb-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# PHP extensions, separated for QEMU build purposes
RUN docker-php-ext-configure gd --with-freetype --with-webp --with-jpeg --with-avif
RUN docker-php-ext-install gd
RUN docker-php-ext-install calendar
RUN docker-php-ext-install intl
RUN docker-php-ext-install pdo_mysql
RUN docker-php-ext-install pdo_pgsql
RUN docker-php-ext-install xml
RUN docker-php-ext-install zip
RUN docker-php-ext-install exif
RUN docker-php-ext-install pcntl
RUN docker-php-ext-install sockets
RUN printf "log_errors = On \nerror_log = /dev/stderr\n" > /usr/local/etc/php/conf.d/php-logs.ini

# Install redis extension with LZ4 and Zstd compression support
RUN pecl install --configureoptions 'enable-redis-lz4="yes" with-liblz4="yes" enable-redis-zstd="yes"' redis \
    && docker-php-ext-enable redis

# Install imagick extension
RUN pecl install imagick && docker-php-ext-enable imagick

# Install maxminddb extension for offline IP -> country lookups.
#
# The C decoder is roughly 100x faster than maxmind-db/reader's pure-PHP
# fallback (~1.7us vs ~160us per lookup), which matters when a lookup happens
# on every request. Requires libmaxminddb0 at runtime -- do not purge it.
RUN pecl install maxminddb && docker-php-ext-enable maxminddb

# GeoIP database (DB-IP Country Lite, CC BY 4.0).
#
# Baked in at build time so lookups are entirely offline; the data refreshes
# whenever the image is rebuilt. GEOIP_DB_PATH is exported so consuming
# applications can locate the database without hardcoding the path.
ENV GEOIP_DB_PATH="/usr/share/GeoIP/dbip-country-lite.mmdb"
COPY fpm/8.3/bin/fetch-geoip-db /usr/local/bin/fetch-geoip-db
RUN chmod +x /usr/local/bin/fetch-geoip-db && fetch-geoip-db

# PHP settings - Flarum tuned OPcache
COPY fpm/8.3/etc/php/flarum.ini /usr/local/etc/php/conf.d/flarum.ini

# Composer - copy binary from official image to avoid QEMU issues with the installer script
COPY --from=composer:latest /usr/bin/composer /usr/local/bin/composer

# AWS CLI - copy from official multi-arch image
COPY --from=amazon/aws-cli:latest /usr/local/aws-cli /usr/local/aws-cli
RUN ln -s /usr/local/aws-cli/v2/current/bin/aws /usr/local/bin/aws

# Resolve PHP_OPCACHE_JIT before handing over to the base image entrypoint,
# which still passes the container's command through unchanged.
COPY fpm/8.3/bin/php-jit-flag /usr/local/bin/php-jit-flag
COPY fpm/8.3/bin/entrypoint /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/php-jit-flag /usr/local/bin/entrypoint

ENTRYPOINT ["entrypoint"]

ENV PROVISION_CONTEXT="cli"
