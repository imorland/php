FROM php:8.5-cli-bookworm

# Ensure interactive shells don't get presented during any apt-get operations
ENV DEBIAN_FRONTEND=noninteractive

# Setup Debian packages
RUN apt-get -y update && apt-get -y upgrade && ACCEPT_EULA=Y && apt-get install -y \
    procps \
    cron \
    unzip \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libmcrypt-dev \
    libzip-dev \
    libxml2-dev \
    libxslt-dev \
    libssl-dev \
    zlib1g-dev \
    libpng-dev \
    libwebp-dev \
    libjpeg-dev \
    libaio1 \
    libonig-dev \
    apt-file \
    wget \
    gnupg \
    gnupg2 \
    zip \
    git \
    curl \
    gcc \
    g++ \
    autoconf \
    libc-dev \
    libc-client-dev \
    pkg-config \ 
    libkrb5-dev \
    iputils-ping \
    netcat-traditional \
    default-mysql-client \
    util-linux \
    gosu \
    jq \
    redis-tools \
    vim \
    liblz4-dev \
    libzstd-dev \
    libmaxminddb0 \
    libmaxminddb-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# PHP extensions, seperated for QEMU build purposes
RUN docker-php-ext-configure gd --with-freetype --with-webp --with-jpeg
RUN docker-php-ext-install gd
RUN docker-php-ext-install calendar
RUN docker-php-ext-install intl
RUN docker-php-ext-install pdo_mysql
RUN docker-php-ext-install xml
RUN docker-php-ext-install zip
RUN docker-php-ext-install exif
RUN docker-php-ext-install pcntl
RUN docker-php-ext-install sockets
RUN printf "log_errors = On \nerror_log = /dev/stderr\n" > /usr/local/etc/php/conf.d/php-logs.ini

# Install redis extension with LZ4 and Zstd compression support
RUN pecl install --configureoptions 'enable-redis-lz4="yes" with-liblz4="yes" enable-redis-zstd="yes"' redis \
    && docker-php-ext-enable redis

# Install maxminddb extension for offline IP -> country lookups.
#
# The C decoder is roughly 100x faster than maxmind-db/reader's pure-PHP
# fallback (~1.7us vs ~160us per lookup), which matters when a lookup happens
# on every request. Requires libmaxminddb0 at runtime -- do not purge it.
RUN pecl install maxminddb && docker-php-ext-enable maxminddb

# GeoIP databases (DB-IP Country, City and ASN Lite, CC BY 4.0).
#
# Baked in at build time so lookups are entirely offline; the data refreshes
# whenever the image is rebuilt. The paths are exported so consuming
# applications can locate the databases without hardcoding them.
#
# GEOIP_DB_PATH keeps its original name for backwards compatibility -- it was
# the only database when this was introduced.
ENV GEOIP_DB_PATH="/usr/share/GeoIP/dbip-country-lite.mmdb" \
    GEOIP_CITY_DB_PATH="/usr/share/GeoIP/dbip-city-lite.mmdb" \
    GEOIP_ASN_DB_PATH="/usr/share/GeoIP/dbip-asn-lite.mmdb"
COPY bin/fetch-geoip-db /usr/local/bin/fetch-geoip-db
RUN chmod +x /usr/local/bin/fetch-geoip-db && fetch-geoip-db

# Declare the bundled data's licence so it is discoverable without unpacking the
# image. This covers the databases the image carries, not the image's own
# content; /usr/share/GeoIP/ATTRIBUTION.txt states what CC BY 4.0 requires.
LABEL org.opencontainers.image.licenses="CC-BY-4.0"

# PHP settings
COPY 8/8.5/etc/php/production.ini /usr/local/etc/php/conf.d/

# Composer
COPY 8/8.5/etc/ssh/* /usr/local/ssh/
RUN sh /usr/local/ssh/install-composer.sh && \
    mv composer.phar /usr/local/bin/composer

### PROD ENVIRONMENT SPECIFIC ###
################################
ENV PROVISION_CONTEXT="cli"
